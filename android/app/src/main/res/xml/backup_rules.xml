<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: what Auto Backup takes. Same exclusions as
     data_extraction_rules.xml (document copies, update downloads, temporary files). -->
<full-backup-content>
    <exclude domain="file" path="docs/" />
    <exclude domain="file" path="updates/" />
    <exclude domain="file" path="update.json" />
    <exclude domain="file" path="cache/" />
    <!-- Fanoratana : les APK téléchargées et les modèles (117 Mo) se retéléchargent ; sans cette exclusion ils
         mangent le quota de sauvegarde, et les cours (fanoratana/Cours) ne seraient plus sauvegardés. -->
    <exclude domain="file" path="fanoratana/mises-a-jour/" />
    <exclude domain="file" path="fanoratana/modeles/" />
</full-backup-content>
